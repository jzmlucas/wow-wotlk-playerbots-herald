+void PlayerbotAI::SetHeraldAutopilotState(HeraldAutopilotState state)
+{
+    if (state == HeraldAutopilotState::DISABLED)
+        heraldAutopilotStates.erase(this);
+    else
+        heraldAutopilotStates[this] = state;
+    rpgInfo.ChangeToIdle();
+
+    if (state == HeraldAutopilotState::PAUSED || state == HeraldAutopilotState::DISABLED)
+    {
+        bot->StopMoving();
+        bot->GetMotionMaster()->Clear();
+        bot->GetMotionMaster()->MoveIdle();
+    }
+
+    ResetStrategies();
+}
+
+HeraldAutopilotState PlayerbotAI::GetHeraldAutopilotState() const
+{
+    auto const it = heraldAutopilotStates.find(this);
+    return it == heraldAutopilotStates.end() ? HeraldAutopilotState::DISABLED : it->second;
+}
