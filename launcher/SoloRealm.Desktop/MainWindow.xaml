<Window x:Class="SoloRealm.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SoloRealm · Control Center" Width="1180" Height="790" MinWidth="940" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#0C1018" Foreground="#F1E9D8">
  <Window.Resources>
    <RadialGradientBrush x:Key="HeroBackdrop" Center="0.5,0.52" GradientOrigin="0.5,0.45" RadiusX="0.75" RadiusY="0.8"><GradientStop Color="#24445B" Offset="0"/><GradientStop Color="#101E2C" Offset="0.52"/><GradientStop Color="#090E17" Offset="1"/></RadialGradientBrush>
    <LinearGradientBrush x:Key="GoldFrame" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#806132" Offset="0"/><GradientStop Color="#E2C780" Offset="0.32"/><GradientStop Color="#6B4A23" Offset="0.68"/><GradientStop Color="#CFAC69" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="PlaySurface" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#BC8A47" Offset="0"/><GradientStop Color="#865420" Offset="0.55"/><GradientStop Color="#4A301A" Offset="1"/></LinearGradientBrush>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Padding" Value="18,12"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#26354A"/><Setter Property="Foreground" Value="#F4D291"/></Trigger></Style.Triggers></Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource PlaySurface}"/><Setter Property="BorderBrush" Value="#E4C486"/><Setter Property="BorderThickness" Value="2"/><Setter Property="FontFamily" Value="Georgia"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="25,11"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#FFF1BE"/></Trigger></Style.Triggers></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#111D2A"/><Setter Property="BorderBrush" Value="#455466"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,12,12"/></Style>
  </Window.Resources>
  <Grid Background="#0C1018">
    <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#0B111C" BorderBrush="#8B683A" BorderThickness="0,0,2,0">
      <DockPanel Margin="17,22">
        <StackPanel DockPanel.Dock="Top" Margin="7,6,0,30"><TextBlock Text="✦ SOLOREALM" Foreground="#E6C376" FontFamily="Georgia" FontSize="22" FontWeight="Bold"/><TextBlock Text="CONTROL CENTER" Foreground="#8EA9C3" FontSize="11" Margin="3,5,0,0"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="#765D3A" Margin="0,0,0,13"/><TextBlock Text="WRATH OF THE LICH KING" Foreground="#91A7BC" FontSize="10"/><TextBlock Text="Reino local · 3.3.5a" Foreground="#D3AE70" FontSize="12" Margin="0,4,0,0"/></StackPanel>
        <StackPanel><Button Content="⌂   Visão geral" Tag="home" Style="{StaticResource NavButton}" Click="Navigate"/><Button Content="⚙   Configurações" Tag="settings" Style="{StaticResource NavButton}" Click="Navigate"/><Button Content="▣   Instalação" Tag="install" Style="{StaticResource NavButton}" Click="Navigate"/><Button Content="☷   Registros" Tag="logs" Style="{StaticResource NavButton}" Click="Navigate"/></StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="24,18,20,18"><Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
      <Grid><StackPanel><TextBlock Text="SEU REINO, SOB SEU COMANDO" Foreground="#B99961" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="PageTitle" Text="Visão geral" FontFamily="Georgia" FontSize="26" Margin="0,3,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1B2B2C" BorderBrush="#46636B" BorderThickness="1" Padding="12,7" CornerRadius="3"><TextBlock x:Name="RealmStatus" Text="Verificando serviços…" Foreground="#93CBB6"/></Border></Grid>
      <Grid Grid.Row="1">
        <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,2,0,0">
          <Border BorderBrush="{StaticResource GoldFrame}" BorderThickness="2" CornerRadius="5" Height="305" Margin="0,0,0,18">
            <Grid Background="{StaticResource HeroBackdrop}" ClipToBounds="True">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Canvas IsHitTestVisible="False" Opacity="0.6">
                <Ellipse Width="460" Height="230" Canvas.Left="175" Canvas.Top="-95" Stroke="#52788B" StrokeThickness="1" Fill="#101927"/>
                <Ellipse Width="590" Height="295" Canvas.Left="110" Canvas.Top="-125" Stroke="#5A4930" StrokeThickness="1"/>
                <Path Data="M 0,40 C 95,85 120,195 20,270 M 790,40 C 690,85 670,195 770,270" Stroke="#4A6680" StrokeThickness="2"/>
                <Path Data="M 110,118 L 180,118 M 610,118 L 680,118 M 125,125 L 170,125 M 620,125 L 665,125" Stroke="#B58F4E" StrokeThickness="2"/>
              </Canvas>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,3,20,14">
                <TextBlock Text="✦    O SEU REINO AGUARDA    ✦" Foreground="#91B6CE" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="SOLOREALM" FontFamily="Georgia" FontSize="53" FontWeight="Bold" Foreground="#F2CF80" HorizontalAlignment="Center">
                  <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="9" ShadowDepth="3"/></TextBlock.Effect>
                </TextBlock>
                <Border Height="2" Width="310" Background="{StaticResource GoldFrame}" Margin="0,7,0,8"/>
                <TextBlock Text="WRATH OF THE LICH KING · 3.3.5a" Foreground="#A8C2D3" FontFamily="Georgia" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,19"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button Content="INICIAR REINO" Tag="start" Style="{StaticResource PrimaryButton}" Click="RunAction" Width="190"/>
                  <Button Content="JOGAR" Tag="open-game" Style="{StaticResource PrimaryButton}" Click="RunAction" Width="155"/>
                </StackPanel>
              </StackPanel>
              <Border Grid.Row="1" Background="#BB090E17" BorderBrush="#6A5538" BorderThickness="0,1,0,0" Padding="13,7">
                <TextBlock Text="⚔   Seu reino local, seus aliados e suas aventuras." HorizontalAlignment="Center" Foreground="#B7C8D4" FontSize="11"/>
              </Border>
            </Grid>
          </Border>
          <TextBlock Text="ESTADO DO REINO" Foreground="#D9B874" FontSize="12" FontWeight="Bold" Margin="0,0,0,11"/>
          <UniformGrid Columns="3" Margin="0,0,0,8"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MYSQL" Foreground="{StaticResource Muted}"/><TextBlock x:Name="MysqlStatus" Text="VERIFICANDO" FontSize="18" Margin="0,7,0,4"/><TextBlock Text="Banco · 3306" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AUTH SERVER" Foreground="{StaticResource Muted}"/><TextBlock x:Name="AuthStatus" Text="VERIFICANDO" FontSize="18" Margin="0,7,0,4"/><TextBlock Text="Login · 3724" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="WORLD SERVER" Foreground="{StaticResource Muted}"/><TextBlock x:Name="WorldStatus" Text="VERIFICANDO" FontSize="18" Margin="0,7,0,4"/><TextBlock Text="Mundo · 8085" Foreground="{StaticResource Muted}"/></StackPanel></Border></UniformGrid>
          <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="CLIENTE DO JOGO" Foreground="{StaticResource Gold}" FontWeight="Bold"/><TextBlock Text="Pasta que contém Wow.exe e Data" Foreground="{StaticResource Muted}" Margin="0,5,0,10"/><DockPanel><Button Content="Selecionar pasta" DockPanel.Dock="Right" Click="BrowseClient" Margin="10,0,0,0"/><TextBox x:Name="ClientPath" VerticalContentAlignment="Center"/></DockPanel></StackPanel></Border>
          <WrapPanel><Button Content="CRIAR BACKUP" Tag="backup" Click="RunAction"/><Button Content="ABRIR LOGS" Tag="open-logs" Click="RunAction"/></WrapPanel>
          <TextBlock Text="A inicialização dos bots pode levar alguns minutos. Acompanhe o progresso em Registros." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel></ScrollViewer>
        <Grid x:Name="SettingsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Ajuste o perfil por categoria. Salve e aplique; reinicie o worldserver para ativar." Foreground="{StaticResource Muted}" Margin="0,5,0,15"/><TabControl x:Name="SettingsTabs" Grid.Row="1" Background="{StaticResource Panel}" Foreground="{StaticResource Text}"/><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0"><Button Content="SALVAR PERFIL" Style="{StaticResource PrimaryButton}" Click="SaveProfileClick"/><Button Content="APLICAR CONFIGURAÇÃO" Click="ApplyProfileClick"/><Button Content="RECARREGAR" Click="ReloadProfileClick"/></StackPanel></Grid>
        <ScrollViewer x:Name="InstallPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Instalação e manutenção" FontFamily="Georgia" FontSize="22" Margin="0,5,0,8"/><TextBlock Text="Execute as etapas conforme necessário. A saída aparece em Registros." Foreground="{StaticResource Muted}" Margin="0,0,0,20"/><WrapPanel x:Name="InstallActions"/></StackPanel></ScrollViewer>
        <Grid x:Name="LogsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock x:Name="TaskStatus" Text="Pronto" Foreground="{StaticResource Gold}" VerticalAlignment="Center"/><Button Content="Abrir arquivo" Margin="25,0,0,0" Click="OpenTaskLog"/></StackPanel><TextBox x:Name="LogOutput" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/></Grid>
      </Grid>
      <Border Grid.Row="2" BorderBrush="#3A4553" BorderThickness="0,1,0,0"><TextBlock x:Name="FooterStatus" Text="Pronto para jogar" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Border>
    </Grid>
  </Grid>
</Window>
