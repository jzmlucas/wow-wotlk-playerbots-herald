<Application x:Class="SoloRealm.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Background" Color="#0C1018"/>
    <SolidColorBrush x:Key="Panel" Color="#151C29"/>
    <SolidColorBrush x:Key="PanelRaised" Color="#1C2635"/>
    <SolidColorBrush x:Key="Gold" Color="#D9A85B"/>
    <SolidColorBrush x:Key="Text" Color="#F1E9D8"/>
    <SolidColorBrush x:Key="Muted" Color="#A5AEC0"/>
    <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource Background}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource PanelRaised}"/><Setter Property="BorderBrush" Value="#48505D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="38"/></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#101724"/><Setter Property="BorderBrush" Value="#414D61"/><Setter Property="Padding" Value="9,7"/><Setter Property="CaretBrush" Value="{StaticResource Gold}"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
  </Application.Resources>
</Application>
